<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Still intentionally no INTERNET permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <queries>
        <package android:name="com.caf.fmradio" />
        <package android:name="com.android.fmradio" />
        <package android:name="com.mediatek.fmradio" />
        <package android:name="com.sec.android.app.fm" />
        <package android:name="com.samsung.android.app.fmradio" />
        <package android:name="com.miui.fm" />
        <package android:name="com.huawei.android.FMRadio" />
        <package android:name="com.motorola.fmplayer" />
        <package android:name="com.oneplus.fmradio" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadioFMX">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
